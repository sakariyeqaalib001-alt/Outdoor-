# Copy to .env.local and fill in real values on your own computer.
# .env.local is ignored by Git. Never commit real values or paste them into chat.

# --- Supabase (Phase 2+) ---
# Project URL and publishable key (safe for the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — server only, bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- SMS / OTP (Phase 3) — SDD §17.1 ---
# test = development only (prints the code in the npm run dev terminal). Production uses telesom.
SMS_PROVIDER=test
# Optional — defaults to https://sms.mytelesom.com/index.php/Gway/sendsms/
TELESOM_API_URL=
TELESOM_USERNAME=
TELESOM_PASSWORD=
TELESOM_API_KEY=
TELESOM_SENDER=SOGASHO

# --- Email alerts (Phase 9) — SDD §17.3, T-25 ---
# brevo | resend | log (log = development only, prints the subject). Empty = email off (alerts wait in the queue).
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
# Sender address (Brevo: a verified single sender, e.g. your work address)
EMAIL_FROM=
EMAIL_FROM_NAME=Sogasho Outdoor
# Address of this app used in email links (default http://localhost:<port>)
APP_BASE_URL=

# --- Scheduled email sender (Phase 11) ---
# Long random value (at least 32 characters). The host's scheduler calls /api/cron/send-emails every 5 minutes
# with "Authorization: Bearer <CRON_SECRET>". Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Training site (T-24) — put these in .env.training.local, NOT here ---
# The training copy has its own Supabase project ("Outdoor Training"). Fill in that project's values in
# .env.training.local (ignored by Git); anything not there (e.g. Telesom) is taken from .env.local.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
